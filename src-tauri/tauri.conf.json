{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MyToolbox",
  "version": "0.4.2",
  "identifier": "com.local.toolbox",
  "build": {
    "beforeDevCommand": "npm run build:plugins && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:all",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "工具箱",
        "width": 1100,
        "height": 800,
        "minWidth": 760,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: plugin: http://plugin.localhost https:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https:",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEwQThCNUU5RkZEQzg2QzUKUldURmh0ei82YldvRU1WUlgxSzdSNzJ3UTViNnZnUHBTMjgxci9TUm9mVlhxNFpyVzFyTG1sUGoK",
      "endpoints": [
        "https://font-c.github.io/myToolbox/store/app-update.json",
        "https://gitee.com/font-c/my-toolbox-store/raw/master/store/app-update.json"
      ]
    }
  }
}
